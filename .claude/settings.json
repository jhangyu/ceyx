{
  "permissions": {
    "allow": [
      "Bash(cmake --build native/build *)",
      "Bash(cmake -S native *)",
      "Bash(cmake -S .. -B . *)",
      "Bash(native/build/test_decode *)",
      "Bash(./native/build/test_decode *)",
      "Bash(./native/build/test_warp_rectilinear_halide *)",
      "Bash(python3 native/tests/run_decode_matrix.py *)",
      "Bash(python3 native/scripts/build_native_watchdog.py *)",
      "Bash(python3 native/scripts/tmp/*)",
      "Bash(bash native/scripts/tmp/*)",
      "Bash(python3 native/tests/compare_psnr.py *)",
      "Bash(./native/build/bench_sdk_warp *)",
      "Bash(./native/build/test_decode_strict_float *)",
      "Bash(otool -L *)",
      "Bash(nm -gU *)",
      "Bash(exiftool *)",
      "Bash(cd *)",
      "Bash(cd * && *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_native_edit.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_build_check.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_reminder.py\""
          }
        ]
      }
    ]
  }
}
