-DCMAKE_BUILD_TYPE=Release
-DCMAKE_INSTALL_PREFIX=/home/build/ceyx-dist
-DBUILD_SHARED_LIBS=ON
-DCMAKE_PREFIX_PATH=/home/build/ceyx-dist
-DLIBDE265_INCLUDE_DIR=/home/build/ceyx-dist/include
-DWITH_LIBDE265=ON
-DWITH_LIBDE265_PLUGIN=OFF
-DENABLE_PLUGIN_LOADING=OFF
-DWITH_X265=OFF
-DWITH_X264=OFF
-DWITH_KVAZAAR=ON
-DWITH_KVAZAAR_PLUGIN=OFF
-DKVAZAAR_INCLUDE_DIR=/home/build/ceyx-dist/include
-DWITH_UVG266=OFF
-DWITH_VVDEC=OFF
-DWITH_VVENC=OFF
-DWITH_AOM_DECODER=ON
-DWITH_AOM_ENCODER=ON
-DWITH_AOM_DECODER_PLUGIN=OFF
-DWITH_AOM_ENCODER_PLUGIN=OFF
-DAOM_INCLUDE_DIR=/home/build/ceyx-dist/include
-DWITH_DAV1D=OFF
-DWITH_SvtEnc=OFF
-DWITH_RAV1E=OFF
-DWITH_OpenH264_DECODER=OFF
-DWITH_FFMPEG_DECODER=OFF
-DWITH_JPEG_DECODER=OFF
-DWITH_JPEG_ENCODER=OFF
-DWITH_OpenJPEG_DECODER=OFF
-DWITH_OpenJPEG_ENCODER=OFF
-DWITH_OPENJPH_ENCODER=OFF
-DWITH_UNCOMPRESSED_CODEC=OFF
-DWITH_HEADER_COMPRESSION=OFF
-DWITH_LIBSHARPYUV=OFF
-DWITH_EXAMPLES=OFF
-DWITH_GDK_PIXBUF=OFF
-DWITH_REDUCED_VISIBILITY=ON
-DBUILD_TESTING=OFF
-DWITH_FUZZERS=OFF
-DCMAKE_INSTALL_NAME_DIR=@rpath
-DLIBDE265_LIBRARY=/home/build/ceyx-dist/lib/libde265.so
-DKVAZAAR_LIBRARY=/home/build/ceyx-dist/lib/libkvazaar.a
-DAOM_LIBRARY=/home/build/ceyx-dist/lib/libaom.a
