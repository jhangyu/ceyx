prefix=D:/a/ceyx/ceyx/native/third_party/heif-dist-windows
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libheif
Description: HEIF image codec.
URL: https://github.com/strukturag/libheif
Version: 1.23.2
Requires:
Requires.private: libde265
Libs: -L${libdir} -lheif
Libs.private: -lstdc++
Cflags: -I${includedir}
Cflags.private: -DLIBHEIF_STATIC_BUILD
