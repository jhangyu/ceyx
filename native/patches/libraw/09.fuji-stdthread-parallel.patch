+#else
+  /* Ceyx project patch 09: std::thread replacement for the OpenMP loop above.
+     Strips are independent by construction -- each one owns its
+     fuji_compressed_block (and, when lossy, its own copy of
+     fuji_compressed_params, fuji_decode_strip() above), reads a disjoint byte
+     range of the input, and writes a disjoint column band of
+     imgdata.rawdata.raw_image via copy_line_to_xtrans()/copy_line_to_bayer().
+     That is the same independence the OpenMP loop already relies on; the only
+     genuinely shared resources are the datastream and derror(), both of which
+     are now under fuji_decode_stream_mutex.
+
+     The pool is bounded by the strip count, is created and joined inside this
+     one call, and never outlives unpack(). Exceptions cannot cross a
+     std::thread boundary, so the first one is captured and rethrown on the
+     calling thread after every worker has been joined -- preserving the
+     serial contract that a failed strip surfaces as a throw from
+     fuji_compressed_load_raw(). */
+  auto decode_one = [&](int cur_block) {
+    fuji_decode_strip(common_info, cur_block, raw_block_offsets[cur_block], block_sizes[cur_block],
+                      q_bases ? q_bases + cur_block * lineStep : 0);
+  };
+
+  unsigned hw = std::thread::hardware_concurrency();
+  int nthreads = int(hw ? hw : 1u);
+  if (nthreads > count)
+    nthreads = count;
+  if (nthreads < 1)
+    nthreads = 1;
+
+  if (nthreads == 1)
+  {
+    /* Single strip (or a single-core host): stay on the original serial path
+       so the degenerate case gains no thread-creation overhead and keeps
+       propagating its exception directly. */
+    for (int cur_block = 0; cur_block < count; cur_block++)
+      decode_one(cur_block);
+    return;
+  }
+
+  std::atomic<int> next_block(0);
+  std::atomic<bool> aborted(false);
+  std::mutex err_mutex;
+  std::exception_ptr first_error;
+
+  auto worker = [&]() {
+    for (;;)
+    {
+      if (aborted.load(std::memory_order_relaxed))
+        return;
+      const int cur_block = next_block.fetch_add(1, std::memory_order_relaxed);
+      if (cur_block >= count)
+        return;
+      try
+      {
+        decode_one(cur_block);
+      }
+      catch (...)
+      {
+        std::lock_guard<std::mutex> err_guard(err_mutex);
+        if (!first_error)
+          first_error = std::current_exception();
+        aborted.store(true, std::memory_order_relaxed);
+        return;
+      }
+    }
+  };
+
+  std::vector<std::thread> pool;
+  pool.reserve(size_t(nthreads - 1));
+  try
+  {
+    for (int i = 0; i < nthreads - 1; i++)
+      pool.emplace_back(worker);
+  }
+  catch (...)
+  {
+    /* Thread creation failed: the strips already claimed are still decoded by
+       the loop below, so this degrades to fewer workers rather than to a
+       partial image. */
+  }
+
+  worker(); // the calling thread is a worker too, never an idle waiter
+
+  for (size_t i = 0; i < pool.size(); i++)
+    pool[i].join(); // unconditional: no thread may outlive this call
+
+  if (first_error)
+    std::rethrow_exception(first_error);
 #endif
