   qt->q_grad_mult = 9;
   params->max_bits = 4 * log2ceil(qp[4] + 1);
+}
+
+/* Ceyx project patch 10: per-q_base memoisation of init_main_qtable().
+
+   For lossy RAF, fuji_decode_strip() re-runs init_main_qtable() (which
+   rebuilds the ~2*max_value-entry setup_qlut() table) on every line whose
+   q_base differs from the previous line's, but the table and every derived
+   scalar are a pure function of (q_base, max_value) -- max_value is fixed for
+   the whole file. Measured share: 9.9% of the decode profile
+   (docs/logs/2026-08-28/Task_xtrans_optimization_eval.md par.2). q_base is a
+   uchar, so a per-strip 256-slot cache keyed by q_base computes each table
+   once and afterwards just swaps the qt[0].q_table pointer + scalars back in.
+   init_main_grads() is decoder STATE, not derived data, and still runs on
+   every transition (caller's responsibility, unchanged).
+
+   The cache is strictly per-strip (lives on fuji_decode_strip()'s stack), so
+   there is no interaction with the strip-parallel pool. */
+struct fuji_qtable_cache
+{
+  /* slot.q_table == NULL means "not computed yet". slot stores a complete
+     fuji_q_table (including the owned q_table pointer) plus the matching
+     params->max_bits. */
+  fuji_q_table slot[256];
+  int max_bits[256];
+};
+
+static void init_main_qtable_cached(fuji_compressed_params *params, uchar q_base, fuji_qtable_cache *cache,
+                                    size_t table_size)
+{
+  if (!cache)
+  {
+    /* Cache allocation failed: degrade to upstream's uncached behaviour
+       (qt[0].q_table still points at the strip's inline blob). */
+    init_main_qtable(params, q_base);
+    return;
+  }
+  fuji_q_table *cached = &cache->slot[q_base];
+  if (!cached->q_table)
+  {
+    /* First sighting of this q_base in this strip: compute into a buffer the
+       cache owns, via the verbatim upstream routine. */
+    params->qt[0].q_table = (int8_t *)calloc(table_size, 1);
+    init_main_qtable(params, q_base);
+    *cached = params->qt[0];
+    cache->max_bits[q_base] = params->max_bits;
+  }
+  else
+  {
+    params->qt[0] = *cached;
+    params->max_bits = cache->max_bits[q_base];
+  }
 }
 
