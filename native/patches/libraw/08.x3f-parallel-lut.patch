+/* CEYX X4: register-resident bit window for the LUT fast path. Carrying the
+   bit position through memory (position -> 4-byte reload -> table load ->
+   position) stalls the per-symbol decode chain on L1 latency every symbol.
+   Holding the next <= 64 stream bits
+   MSB-aligned in a register turns the carried chain into
+   idx -> 2 KB L1 entry load -> shift, refilled in 32-bit gulps.
+
+   `bits` is the number of valid bits in `win` (from the MSB); `rd` is the
+   next unread stream byte. bits == -1 is the "window dead" sentinel used
+   when a cold escape lands too close to the block end to re-seed the window;
+   from then on the caller's bit_state_t (kept authoritative by the escape
+   path) drives the verbatim get_true_diff() walk, exactly as pre-LUT code. */
+typedef struct ceyx_bitwin_s
+{
+  uint64_t win;
+  int bits;
+  uint8_t *rd;
+} ceyx_bitwin_t;
+
+static inline int32_t ceyx_get_true_diff_win(bit_state_t *BS,
+                                             x3f_hufftree_t *HTP,
+                                             const ceyx_true_lut_t *lut,
+                                             const uint8_t *end,
+                                             ceyx_bitwin_t *W)
+{
+  if (W->bits >= 0)
+  {
+    if (W->bits <= 32 && W->rd + 4 <= end)
+    {
+      const uint32_t c = ((uint32_t)W->rd[0] << 24) |
+                         ((uint32_t)W->rd[1] << 16) |
+                         ((uint32_t)W->rd[2] << 8) | (uint32_t)W->rd[3];
+
+      W->win |= (uint64_t)c << (32 - W->bits);
+      W->bits += 32;
+      W->rd += 4;
+    }
+
+    {
+      const uint32_t idx = (uint32_t)(W->win >> 56);
+      const ceyx_true_lut_entry_t e = lut->e[idx];
+
+      if (e.total != 0 && (int)e.total <= W->bits)
+      {
+        /* Field layout inside the first `total` window bits: code, then the
+           diff field; `mask` selects the diff field's low `bits` bits. */
+        const uint32_t v = (uint32_t)(W->win >> (64 - e.total)) & e.mask;
+        const uint32_t sign = (v >> e.sign_shift) & 1u;
+        const int32_t diff = (int32_t)v - (int32_t)(e.mask & (sign - 1u));
+
+        W->win <<= e.total;
+        W->bits -= e.total;
+        return diff;
+      }
+    }
+
+    /* Cold escape: run the verbatim walk from the canonical (byte, offset)
+       position implied by the window, then re-seed the window after it. */
+    {
+      uint8_t *byte = W->rd - ((W->bits + 7) >> 3);
+      int off = (8 - (W->bits & 7)) & 7;
+      int32_t diff;
+
+      ceyx_bs_store(BS, byte, off);
+      diff = get_true_diff(BS, HTP);
+      ceyx_bs_pos(BS, &byte, &off);
+
+      W->rd = byte;
+      W->win = 0;
+      W->bits = 0;
+      while (W->bits <= 56 && W->rd < end)
+      {
+        W->win |= (uint64_t)(*W->rd) << (56 - W->bits);
+        W->bits += 8;
+        W->rd++;
+      }
+      if (W->bits >= off)
+      {
+        W->win <<= off;
+        W->bits -= off;
+      }
+      else
+      {
+        W->bits = -1; /* window dead: BS (already in sync) takes over */
+      }
+      return diff;
+    }
+  }
+
+  return get_true_diff(BS, HTP);
+}
