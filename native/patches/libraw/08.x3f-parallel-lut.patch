+/* ---- CEYX X3: 256-entry Huffman LUT for the TRUE engine ---------------
+   The TRUE coding tree is built with new_huffman_tree(&TRU->tree, 8), so no
+   code is longer than 8 bits and a single 256-entry table resolves every
+   symbol in one lookup instead of one get_bit() call per tree level.
+
+   The table is only ever a FAST PATH: any index that does not resolve inside
+   8 bits, any leaf whose diff width is out of range, and any position too
+   close to the end of the compressed block fall back to the original
+   get_true_diff() bit-by-bit walk, so the decoded values are identical by
+   construction (including the "invalid code -> return 0" behaviour).
+
+   It deliberately lives in this .cpp as a local type rather than as a new
+   field of x3f_hufftree_t, so internal/x3f_tools.h stays untouched. */
+
+#define CEYX_TRUE_LUT_BITS 8
+#define CEYX_TRUE_LUT_SIZE (1 << CEYX_TRUE_LUT_BITS)
+/* Widest diff field the fast path will emit; wider leaves escape to the slow
+   path. 16 keeps len(<=8) + bits(<=16) + bit_offset(<=7) inside 32 bits. */
+#define CEYX_TRUE_LUT_MAX_DIFF_BITS 16
+
+/* CEYX X4: one packed 12-byte entry per 8-bit window so the hot path issues a
+   single table load and decodes the diff field branchlessly (the original
+   `first_bit == 0` sign fold is a data-dependent ~50/50 branch; the two
+   separate len[] / diff_bits[] loads are fused into this one entry). */
+typedef struct ceyx_true_lut_entry_s
+{
+  /* Code bits + diff-field bits consumed; 0 means "escape to slow path". */
+  uint8_t total;
+  /* Position of the diff field's sign bit inside the field: bits - 1
+     (0 when bits == 0, where `mask` is 0 and the value below stays 0). */
+  uint8_t sign_shift;
+  uint8_t pad0;
+  uint8_t pad1;
+  /* (1u << bits) - 1: extraction mask for the diff field, 0 when bits == 0.
+     Also the amount subtracted when the sign bit is 0 (matches the original
+     `diff -= (1 << bits) - 1`). */
+  uint32_t mask;
+} ceyx_true_lut_entry_t;
 
+typedef struct ceyx_true_lut_s
+{
+  ceyx_true_lut_entry_t e[CEYX_TRUE_LUT_SIZE];
+} ceyx_true_lut_t;
+
+static void ceyx_build_true_lut(const x3f_hufftree_t *HTP, ceyx_true_lut_t *lut)
+{
+  int i;
+
+  for (i = 0; i < CEYX_TRUE_LUT_SIZE; i++)
+  {
+    const x3f_huffnode_t *node = &HTP->nodes[0];
+    int depth = 0;
+    int bits;
+
+    lut->e[i].total = 0;
+    lut->e[i].sign_shift = 0;
+    lut->e[i].pad0 = 0;
+    lut->e[i].pad1 = 0;
+    lut->e[i].mask = 0;
+
+    while (node != NULL &&
+           (node->branch[0] != NULL || node->branch[1] != NULL) &&
+           depth < CEYX_TRUE_LUT_BITS)
+    {
+      const int bit = (i >> (CEYX_TRUE_LUT_BITS - 1 - depth)) & 1;
+      node = node->branch[bit];
+      depth++;
+    }
+
+    if (node == NULL || depth == 0 || depth > CEYX_TRUE_LUT_BITS)
+      continue; /* invalid code / degenerate root: escape */
+    if (node->branch[0] != NULL || node->branch[1] != NULL)
+      continue; /* still internal after 8 bits: escape */
+    if (node->leaf == UNDEFINED_LEAF ||
+        node->leaf > (uint32_t)CEYX_TRUE_LUT_MAX_DIFF_BITS)
+      continue; /* out of the fast path's modelled range: escape */
+
+    bits = (int)node->leaf;
+    lut->e[i].total = (uint8_t)(depth + bits);
+    lut->e[i].sign_shift = (uint8_t)(bits > 0 ? bits - 1 : 0);
+    lut->e[i].mask = bits > 0 ? ((1u << bits) - 1u) : 0u;
+  }
+}
+
+/* Canonical bit position of BS: (byte, offset-in-byte, MSB first). */
+static inline void ceyx_bs_pos(const bit_state_t *BS, uint8_t **byte, int *off)
+{
+  if (BS->bit_offset == 8)
+  {
+    *byte = BS->next_address;
+    *off = 0;
+  }
+  else
+  {
+    *byte = BS->next_address - 1;
+    *off = BS->bit_offset;
+  }
+}
+
+/* Write a canonical (byte, offset) position back into BS, leaving it in exactly
+   the state the equivalent run of get_bit() calls would have produced.
+   Only used when the fast path escapes, so the 8-bit expansion here is off the
+   hot path. */
+static inline void ceyx_bs_store(bit_state_t *BS, uint8_t *byte, int off)
+{
+  if (off == 0)
+  {
+    BS->next_address = byte;
+    BS->bit_offset = 8;
+  }
+  else
+  {
+    uint8_t b = *byte;
+    int i;
+
+    for (i = 7; i >= 0; i--)
+    {
+      BS->bits[i] = b & 1;
+      b = (uint8_t)(b >> 1);
+    }
+    BS->next_address = byte + 1;
+    BS->bit_offset = (uint8_t)off;
+  }
+}
