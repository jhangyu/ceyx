+/* CEYX X2: the three TRUE colour planes are decoded in parallel.
+   Each plane owns every piece of mutable state it touches: its own
+   bit_state_t, its own row_start_acc/acc, its own bitstream
+   (TRU->plane_address[color], disjoint 16-byte-aligned regions) and its own
+   output slots (interleaved `color` lane of TRU->x3rgb16, or Q->top16 for the
+   binned Quattro plane 2). The only shared state is read-only: the Huffman
+   tree, the LUT built from it, and the image dimensions.
+
+   true_decode_one_color() can throw LIBRAW_EXCEPTION_IO_CORRUPT, and an
+   exception escaping a std::thread would call std::terminate, so each worker
+   captures its exception and the joiner rethrows the first one - preserving
+   the serial version's error behaviour. */
 static void true_decode(x3f_info_t * /*I*/, x3f_directory_entry_t *DE)
 {
   x3f_directory_entry_header_t *DEH = &DE->header;
   x3f_image_data_t *ID = &DEH->data_subsection.image_data;
   int color;
 
+  ceyx_true_lut_t lut;
+  ceyx_build_true_lut(&ID->tru->tree, &lut);
+
+  std::exception_ptr errors[3] = {nullptr, nullptr, nullptr};
+  std::thread workers[3];
+
   for (color = 0; color < 3; color++)
   {
-    true_decode_one_color(ID, color);
+    workers[color] = std::thread([ID, color, &lut, &errors]() {
+      try
+      {
+        true_decode_one_color(ID, color, &lut);
+      }
+      catch (...)
+      {
+        errors[color] = std::current_exception();
+      }
+    });
   }
+
+  for (color = 0; color < 3; color++)
+    workers[color].join();
+
+  for (color = 0; color < 3; color++)
+    if (errors[color])
+      std::rethrow_exception(errors[color]);
 }
 
