+/* CEYX X3: LUT fast path over get_true_diff(). `end` is one past the last
+   readable byte of the compressed block; when the fast path cannot guarantee
+   its 4-byte lookahead stays inside it, the original walk runs instead.
+
+   The bit position is carried in plain (byte, off) locals owned by the caller's
+   row loop, so the hot path never touches bit_state_t's per-bit cache array;
+   the position is only materialised into `*BS` when escaping to the slow
+   walk, and read back from it afterwards. */
+static inline int32_t ceyx_get_true_diff_lut(bit_state_t *BS,
+                                             x3f_hufftree_t *HTP,
+                                             const ceyx_true_lut_t *lut,
+                                             const uint8_t *end,
+                                             uint8_t **pbyte, int *poff)
+{
+  uint8_t *byte = *pbyte;
+  const int off = *poff;
+
+  if (byte + 4 <= end)
+  {
+    const uint32_t w = ((uint32_t)byte[0] << 24) | ((uint32_t)byte[1] << 16) |
+                       ((uint32_t)byte[2] << 8) | (uint32_t)byte[3];
+    const uint32_t idx = (w >> (24 - off)) & 0xff;
+    const int len = lut->len[idx];
+
+    if (len != 0)
+    {
+      const int bits = lut->diff_bits[idx];
+      const int total = len + bits;
+
+      if (off + total <= 32)
+      {
+        const int abs_off = off + total;
+        int32_t diff = 0;
+
+        *pbyte = byte + (abs_off >> 3);
+        *poff = abs_off & 7;
+
+        if (bits != 0)
+        {
+          const uint32_t v = (w >> (32 - abs_off)) & ((1u << bits) - 1u);
+
+          diff = (int32_t)v;
+          /* first_bit == 0 in the original loop */
+          if ((v >> (bits - 1)) == 0)
+            diff -= (1 << bits) - 1;
+        }
+
+        return diff;
+      }
+    }
+  }
+
+  {
+    int32_t diff;
+
+    ceyx_bs_store(BS, byte, off);
+    diff = get_true_diff(BS, HTP);
+    ceyx_bs_pos(BS, pbyte, poff);
+    return diff;
+  }
 }
 
