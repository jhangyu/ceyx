{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 14,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-metal",
      "displayName": "macOS Metal (native)",
      "description": "Native macOS build with Halide Metal GPU backend",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-vulkan-stage1",
      "displayName": "Android Vulkan Stage 1 (host generators)",
      "description": "Build host-side Halide generators and run AOT for strict Android ARM64 Vulkan target requiring vk_int8/vk_int16/vk_int64",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-android/host-generators",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DNG_HOST_GENERATORS_ONLY": "ON",
        "DNG_AOT_TARGET_OVERRIDE": "arm-64-android-vulkan-vk_int8-vk_int16-vk_int64-no_asserts-no_bounds_query"
      }
    },
    {
      "name": "android-vulkan",
      "displayName": "Android Vulkan (cross-compile)",
      "description": "Android ARM64 cross-compile with strict Halide Vulkan GPU backend (vk_int8/vk_int16/vk_int64; Stage 2 requires Stage 1 first)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-android/android-arm64",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_shared",
        "CMAKE_BUILD_TYPE": "Release",
        "DNG_CROSS_BUILD": "ON",
        "DNG_PREBUILT_AOT_DIR": "${sourceDir}/build-android/host-generators/halide_generated",
        "DNG_ENABLE_WARP_PRECOMPUTED_DIAG": "OFF",
        "DNG_DIAGNOSTIC_BUILD": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-metal",
      "configurePreset": "macos-metal",
      "targets": ["dng_decoder_native", "test_decode"]
    },
    {
      "name": "android-vulkan-stage1",
      "configurePreset": "android-vulkan-stage1"
    },
    {
      "name": "android-vulkan",
      "configurePreset": "android-vulkan",
      "targets": ["dng_decoder_native"]
    }
  ]
}
